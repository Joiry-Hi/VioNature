# =============================================================================
#  Build outputs  (CMake + compiler intermediates)
# =============================================================================
build/
build-local/
build-sandbox/
build-windows/

# Keep the explicit build directory patterns below as documentation for older
# checkouts where some generated files may already be tracked.
build-windows/CMakeFiles/
build-windows/cmake_install.cmake
build-windows/CMakeCache.txt
build-windows/Makefile
build-windows/*.dir/
build-windows/*.o
build-windows/*.obj
build-sandbox/CMakeFiles/
build-sandbox/cmake_install.cmake
build-sandbox/CMakeCache.txt
build-sandbox/Makefile
build-sandbox/*.dir/
build-sandbox/*.o
build-sandbox/*.obj
build-sandbox/external/

# Compiled binaries in build directories
build-windows/*.exe
build-windows/*.dll
build-windows/*.a
build-windows/*.lib
build-sandbox/*.exe
build-sandbox/*.dll
build-sandbox/*.a
build-sandbox/*.lib

# Web build staging output generated by scripts/build-web.sh
web-release/build/
web-release/dist/
web-release/packages/

# Lightweight no-audio Web build output generated by scripts/build-web-no-audio.sh
web-release-no-audio/

# Legacy Web output paths from older build-web.sh versions
build-web/
dist-web/

# =============================================================================
#  IDE & editor
# =============================================================================
.vscode/
.idea/
*.swp
*.swo
*.user
*.suo

# =============================================================================
#  OS junk
# =============================================================================
.DS_Store
Thumbs.db
desktop.ini

# =============================================================================
#  AI assistant artifacts
# =============================================================================
.claude/
memory/
*.tmp
*.bak

# =============================================================================
#  Release packages  (generated by package/build scripts)
# =============================================================================
VioNature_Release*.zip
web-release/*.zip
web-release/packages/*.zip
*.tar.gz
*.7z
